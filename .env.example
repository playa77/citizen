# ==========================================
# Citizen — Environment Template
# Copy to .env and fill in real values.
# ==========================================
# Semantic Version: 0.4.0
# Mirrors app/core/config.py — that file is authoritative for defaults.

# Database (required)
# PostgreSQL 16 with pgvector extension — the only supported backend (D-024).
DATABASE_URL=postgresql+asyncpg://local_user:local_pass@localhost:5432/citizen_db

# LLM Routing (required)
# OpenRouter API key — only pseudonymized text is sent to external providers.
OPENROUTER_API_KEY=

# Deployment posture (WP-62 / WP-66, D-019)
# dev      — author-only testing with synthetic data only (Art. 2(8) AI Act);
#            the app REFUSES to start unless CITIZEN_SYNTHETIC_DATA_ONLY=true,
#            and document uploads require X-Document-Tag: synthetic|goldset.
# self     — author-only use on the author's own real Bescheide (personal use)
# provider — deployed so that any third party can obtain an analysis
DEPLOYMENT_MODE=dev
CITIZEN_SYNTHETIC_DATA_ONLY=true

# Inference profiles (WP-31) — active profile name from config/inference_profiles.yaml
INFERENCE_PROFILE=eu-avv
# Allow non-signed profiles without signed AVV (dev convenience; off in production)
AVV_OVERRIDE=false

# LLM model selection (defaults match the deterministic fallback chain)
PRIMARY_MODEL=deepseek/deepseek-v4-pro
FALLBACK_MODEL_1=deepseek/deepseek-v4-flash
FALLBACK_MODEL_2=deepseek/deepseek-v4-flash

# Per-stage model overrides (optional — None = use PRIMARY_MODEL)
TRIAGE_MODEL=
FINAL_MODEL=
CALCULATION_MODEL=
OCR_SYNTHESIS_MODEL=deepseek/deepseek-v4-pro

# Retry and timeout behaviour for the OpenRouter client
MAX_RETRIES=3
REQUEST_TIMEOUT=25

# Timeout budget (seconds) — chain must stay ordered (D-017):
# nginx proxy timeout > PIPELINE_TIMEOUT_SEC > sum of per-call timeouts.
PIPELINE_TIMEOUT_SEC=480
TRIAGE_TIMEOUT_SEC=60
FINAL_TIMEOUT_SEC=180
EMBEDDING_TIMEOUT_SEC=30
CALCULATION_TIMEOUT_SEC=90

# Stage combination (one LLM call per group when true)
COMBINE_TRIAGE_STAGES=true
COMBINE_FINAL_STAGES=true

# Connection pool size for async SQLAlchemy engine (asyncpg)
DB_POOL_SIZE=10

# Document ingestion limits
MAX_FILE_SIZE_MB=25
OCR_DPI=300
OCR_JPG_QUALITY=84
OCR_CONTRAST_FACTOR=2.0
OCR_BW_THRESHOLD=128

# Dual-OCR LLM synthesis (WP-012)
ENABLE_OCR_LLM_SYNTHESIS=false
MAX_OCR_SYNTHESIS_CHARS=6000
OCR_MAX_PAGES=10

# OCR quality gate (WP-42)
OCR_QUALITY_ENABLED=true
OCR_QUALITY_MIN_SCORE=0.3
OCR_QUALITY_WARN_SCORE=0.8

# Embedding / retrieval config
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_KEY=  # Optional — falls back to OPENROUTER_API_KEY. Set only if using a separate key for embeddings.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1/embeddings

# --- Modules (WP-91, D-036/D-037) ---
# Default module for requests that name none; must be in the enabled set or
# startup fails.
DEFAULT_MODULE=sozialrecht
# Explicit enablement list (JSON, e.g. ["sozialrecht"]). Unset → the tier
# rule of D-037 applies: dev/self enable installed experimental+verified
# modules, provider only verified; community is never enabled implicitly.
# ENABLED_MODULES=
VECTOR_DIM=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_BATCH_CONCURRENCY=4
TOP_K_RETRIEVAL=10
MAX_COSINE_DISTANCE=0.65
MAX_COSINE_DISTANCE_STRICT=0.85
RETRIEVAL_MODE=per_question  # "combined" or "per_question"
RETRIEVAL_KEYWORD_FALLBACK=true
TOP_K_KEYWORD=5

# Corpus ingestion (WP-014)
CORPUS_SOURCES=["sgb2", "sgbx"]
CORPUS_INGESTION_TIMEOUT_SEC=1800

# Calculation check (WP-14)
ENABLE_CALCULATION_CHECK=true

# Prompt / token budgeting — prevent giant prompts from exploding latency (WP-010)
MAX_TRIAGE_INPUT_CHARS=8000
MAX_FINAL_INPUT_CHARS=5000
MAX_CHUNK_CONTEXT_CHARS=7000
MAX_CHUNKS_FOR_FINAL=12

# Caching (WP-011)
ENABLE_CACHE=true
CACHE_TTL_SEC=86400

# Streaming of model output during analysis progress
ENABLE_PROGRESS_STREAM=true

# Pseudonymization before external inference (WP-30)
PSEUDONYMIZATION_ENABLED=true

# Prüfstand: goldset path and eval results directory (WP-14)
GOLDSET_PATH=eval/goldsets/goldset-v0.1.0.yaml
EVAL_RESULTS_DIR=eval/results

# Application logging
LOG_LEVEL=INFO

# Rate limiting (in-memory sliding window) — the middleware is currently NOT
# mounted in app/main; 0 disables it even if mounted.
RATE_LIMIT_REQUESTS=0
RATE_LIMIT_WINDOW=60

# Consent / disclaimer
DISCLAIMER_VERSION=v0.1.0
