{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citizen.local/schemas/module-dossier-v1.0.json",
  "title": "Citizen module dossier content (dossier.yaml) v1.0",
  "description": "Module data for the appointment dossier (WP-102): document checklist, lawyer/advisor question list, chronology cues, optional dossier goldset. Version 1.0.0 | 2026-11-16.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "checklist", "questions"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "when": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "any_keyword": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        }
      }
    },
    "checklist_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_de", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label_de": {"type": "string", "minLength": 3},
        "why_de": {"type": "string", "minLength": 3},
        "topic": {"$ref": "#/$defs/id"},
        "required": {"type": "boolean"},
        "merge_key": {"$ref": "#/$defs/id"},
        "when": {"$ref": "#/$defs/when"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text_de"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text_de": {"type": "string", "minLength": 5},
        "topic": {"$ref": "#/$defs/id"},
        "merge_key": {"$ref": "#/$defs/id"},
        "when": {"$ref": "#/$defs/when"}
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label_de", "before_any"],
      "properties": {
        "kind": {"$ref": "#/$defs/id"},
        "label_de": {"type": "string", "minLength": 2},
        "before_any": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        }
      }
    }
  },
  "properties": {
    "format": {"const": "citizen-module-dossier-v1.0"},
    "checklist": {"type": "array", "items": {"$ref": "#/$defs/checklist_item"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "chronology_cues": {"type": "array", "items": {"$ref": "#/$defs/cue"}},
    "goldset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "\\.yaml$"},
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deadline_completeness_min": {"type": "number", "minimum": 0, "maximum": 1},
            "checklist_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
            "chronology_accuracy_min": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
