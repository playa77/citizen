{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citizen.dev/schemas/module-errata-1.0.json",
  "title": "Citizen module errata (citizen-module-errata-v1.0)",
  "description": "Schema for the file a module manifest declares under `errata` (WP-110, ARCHITECTURE.md § 6.2). One entry per published correction: which module versions produced wrong results, which version fixes it, and what a person with an affected case should do. Cases are identified by case_run_area.module_version.",
  "type": "object",
  "required": ["format", "errata"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "citizen-module-errata-v1.0"},
    "errata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "published", "affected_versions", "fixed_in", "severity",
          "component", "summary_de", "summary_en", "action_de"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^E-\\d{4}-\\d{3}$"},
          "published": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "affected_versions": {
            "type": "string",
            "minLength": 1,
            "description": "Module version range, e.g. '>=1.0.0,<1.3.0' (app.modules.semver)."
          },
          "fixed_in": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "severity": {"enum": ["critical", "major", "minor"]},
          "component": {
            "enum": ["parameter", "deadline", "calculator", "template", "dossier", "copy", "prompt", "other"]
          },
          "summary_de": {"type": "string", "minLength": 1},
          "summary_en": {"type": "string", "minLength": 1},
          "action_de": {"type": "string", "minLength": 1},
          "action_en": {"type": "string", "minLength": 1},
          "core_versions": {
            "type": "string",
            "description": "Optional core version range when the defect sat in the core but surfaced through this module."
          },
          "references": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
