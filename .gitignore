# ==========================================
# Citizen - .gitignore
# Version: 1.2.0 | 2026-08-25
# ==========================================

# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
.env_python/

# Environment Variables / Secrets
# (Explicitly ignoring .env to prevent secret leakage)
.env
.env.local
.env.development
.env.production
*.pem
.secret_salt

# Local production override (carries DB credentials, see DEPLOYMENT.md)
docker-compose.override.yml

# Logs
# (As specified in Document 2: Project Structure)
logs/
*.log

# Testing & Coverage
.benchmarks
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Type Checking
.mypy_cache/
.pyre/
.ruff_cache/

# Database / State
*.sqlite3
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm

# PostgreSQL local development / testing
postgresql.conf
pg_hba.conf
pgdata/
postgres_data/
postgresql/data/
.pgpass
.pg_service.conf
*.pid
postmaster.pid
.s.PGSQL.*

# (Note: alembic.ini and alembic/versions/ are tracked, do not ignore them)

# OS / IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Build / Distribution
build/
develop-eggs/
dist/
node_modules/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Uploads / Ephemeral Data
# (Prevent accidental commit of user documents)
uploads/
tmp/
temp/

# Runtime state written by the corpus service (source selection)
.corpus_sources.json

# misc stuff
ideas/
ideas.txt
archive.zip
citizen.zip
.qwen/
QWEN.md
deploy_db.sh

# Eval — goldsets are tracked; results and run outputs are not
# Eval results are git-ignored by default; the P9 baseline report is the
# tracked exception (WP-90 exit criterion: report committed under
# eval/results/). Negations must come after the ignore rule.
eval/results/*
!eval/results/.gitkeep
!eval/results/20261116T094340Z-e9fb87a.json
eval/__pycache__/
